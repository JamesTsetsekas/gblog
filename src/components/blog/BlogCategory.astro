---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@support/time'

interface Props {
    slug: string
    title: string
    description: string
    count: number
    latest: CollectionEntry<'posts'>
}

const { slug, title, description, count, latest } = Astro.props
---

<a
    href={`/categories/${slug}/`}
    class="group flex h-full flex-col rounded-xl border border-neutral-300/70 bg-neutral-100 p-6 outline-none transition-colors hover:border-orange-400 focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-4 focus-visible:ring-offset-neutral-200 dark:border-neutral-700 dark:bg-neutral-900/30 dark:hover:border-orange-400 dark:focus-visible:ring-offset-neutral-800"
    data-category-card={slug}
>
    <div class="flex items-start justify-between gap-4">
        <h3 class="text-2xl font-semibold tracking-tight text-neutral-800 transition-colors group-hover:text-orange-600 dark:text-neutral-200 dark:group-hover:text-orange-300">
            {title}
        </h3>
        <span class="shrink-0 pt-1 text-sm tabular-nums text-neutral-500 dark:text-neutral-400">
            {count} {count === 1 ? 'post' : 'posts'}
        </span>
    </div>
    <p class="mt-3 max-w-prose text-pretty leading-relaxed text-neutral-600 dark:text-neutral-400">
        {description}
    </p>
    <div class="mt-auto pt-6">
        <div class="border-t border-neutral-300/70 pt-4 dark:border-neutral-700">
            <p class="text-xs text-neutral-500 dark:text-neutral-400">
                Latest &middot; <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time>
            </p>
            <p class="mt-1 flex items-start justify-between gap-4 text-sm font-medium leading-relaxed text-neutral-700 dark:text-neutral-300">
                <span>{latest.data.title}</span>
                <svg class="mt-1 size-4 shrink-0 text-orange-600 dark:text-orange-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
            </p>
        </div>
    </div>
</a>
